<!DOCTYPE html>
<html lang="en">
<head>
    <title>Edit Book</title>
</head>
<body>

    <h1>Edit Book</h1>

    <form action="/edit/<%= book.id %>" method="POST">

        <input type="text" name="title" value="<%= book.title %>"><br><br>

        <input type="text" name="author" value="<%= book.author %>"><br><br>

        <input type="number" name="rating" value="<%= book.rating %>"><br><br>

        <textarea name="notes"><%= book.notes %></textarea><br><br>

        <input type="date" name="date_read" value="<%= book.date_read.toISOString().split('T')[0] %>"><br><br>

        <button type="submit">Save Changes</button>

    </form>

</body>
</html>